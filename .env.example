# ============================================================================
# thanwy.ccen — Church Meeting Website Template
# Copy this file to `.env.local` (never commit real secrets) and fill in the
# values for YOUR meeting. See TEMPLATE.md for the full setup guide.
# ============================================================================

# ─── Public (safe for the browser, exposed in the client bundle) ────────────

# Supabase project (prayer wall + notification history). One project per meeting.
# The public key works under either name — classic anon key or the newer
# publishable key that the Supabase↔Vercel integration manages.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # alternative to ANON_KEY
# Non-prefixed aliases (same values) — read at RUNTIME by API routes so a
# stale production build without NEXT_PUBLIC_* vars can still pick them up.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only secret (Supabase dashboard → Project Settings → API → service_role).
# Required for the notification inbox history, content admin, and all attendance
# operations. It is never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary cloud account (gallery images, invitations, meeting JSON data).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# OneSignal web-push app id (same value as ONESIGNAL_APP_ID below).
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# Public site URL — base for push-notification click-through links
# (e.g. https://thanwy.ccen). Falls back to siteConfig.url.
NEXT_PUBLIC_SITE_URL=

# ─── Server-only secrets (NEVER expose these) ───────────────────────────────

# Cloudinary API credentials (uploads + folder management).
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin dashboard password (sent as x-admin-password header by /admin).
ADMIN_PASSWORD=

# OneSignal REST API key (server-side sends).
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# Bearer token protecting /api/cron/* and /api/test-notification.
CRON_SECRET=

# ─── Meeting-specific optional overrides ────────────────────────────────────

# Cloudinary folder holding this meeting's app data, invitations, content
# covers, and public gallery root. Defaults: "thanwy_events" and
# "thanwy_gallery". If meetings share a Cloudinary account, these namespaces
# MUST remain unique. Migrate existing gallery folders before deployment.
CLOUDINARY_MEETING_FOLDER=
CLOUDINARY_GALLERY_FOLDER=
